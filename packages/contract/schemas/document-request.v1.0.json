{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sovereign-dispatch.dev/contract/v1.0/document-request.json",
  "title": "DocumentRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "idempotencyKey", "source", "document", "outputs", "delivery"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": ["string", "null"], "format": "uuid" },
    "idempotencyKey": { "type": "string", "format": "uuid" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "tenantId"],
      "properties": {
        "system": { "type": "string", "enum": ["emergency-ai", "saas-ui", "internal"] },
        "actor": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "displayName": { "type": ["string", "null"] },
            "role": { "type": ["string", "null"] }
          }
        },
        "tenantId": { "type": "string", "format": "uuid" },
        "correlationId": { "type": ["string", "null"] }
      }
    },
    "document": { "$ref": "https://schemas.sovereign-dispatch.dev/ddm/v1.0/document.json" },
    "outputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "enum": ["pdf", "docx", "md"] }
    },
    "package": { "type": "null" },
    "compliance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "pdfProfile": { "type": "string", "enum": ["none", "pdf_a_2b"], "default": "none" },
        "accessibility": { "type": "string", "enum": ["none", "pdf_ua"], "default": "none" }
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "const": "async" },
        "callbackUrl": { "type": ["string", "null"], "format": "uri" },
        "callbackAuth": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["type"], "properties": { "type": { "const": "hmac" } }
        },
        "storage": { "type": "string", "enum": ["signed_url"], "default": "signed_url" },
        "ttlSeconds": { "type": "integer", "minimum": 300, "maximum": 2592000, "default": 604800 }
      }
    }
  }
}
